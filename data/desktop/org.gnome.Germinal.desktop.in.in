[Desktop Entry]
Type=Application
Name=Germinal
GenericName=Terminal Emulator
Comment=Minimalist vte-based terminal emulator
Keywords=Terminal;
Icon=utilities-terminal
Exec=@bindir@/germinal
DBusActivatable=true
Terminal=false
Categories=GTK;GNOME;Utility;TerminalEmulator;System;
StartupWMClass=germinal
StartupNotify=true
Actions=preferences;about;

[Desktop Action preferences]
Name=Preferences
Exec=@bindir@/germinal preferences

[Desktop Action about]
Name=About
Exec=@bindir@/germinal about
